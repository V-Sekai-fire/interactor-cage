# Embed kernels/cage's SPIR-V into the guest as byte arrays, without Python
# (RFD 2239): the same header kernels/embed_spv.py writes for the other
# stages -- one `static const uint8_t k_<name>[]` per .spv, sorted by name,
# plus a name -> bytes table.
#
#   cmake -DSPV_DIR=<dir> -DOUT=<out.inc> [-DNAMESPACE=cage_kernels] -P kernels/cage/embed_spv.cmake
if(NOT SPV_DIR OR NOT OUT)
	message(FATAL_ERROR "usage: cmake -DSPV_DIR=<dir> -DOUT=<out.inc> [-DNAMESPACE=ns] -P embed_spv.cmake")
endif()
if(NOT NAMESPACE)
	set(NAMESPACE cage_kernels)
endif()
file(GLOB _spv LIST_DIRECTORIES false "${SPV_DIR}/*.spv")
list(SORT _spv)
list(LENGTH _spv _n)
if(_n EQUAL 0)
	message(FATAL_ERROR "no .spv under ${SPV_DIR}")
endif()
set(_text "// Generated by kernels/cage/embed_spv.cmake from ${SPV_DIR}. Do not edit; regenerate.\n#pragma once\n#include <cstddef>\n#include <cstdint>\n\nnamespace ${NAMESPACE} {\n\n")
set(_entries "")
set(_total 0)
foreach(f IN LISTS _spv)
	get_filename_component(_stem "${f}" NAME_WE)
	string(MAKE_C_IDENTIFIER "${_stem}" _id)
	file(READ "${f}" _hex HEX)
	string(LENGTH "${_hex}" _hl)
	math(EXPR _bytes "${_hl} / 2")
	math(EXPR _rem "${_bytes} % 4")
	string(SUBSTRING "${_hex}" 0 8 _magic)
	if(NOT _rem EQUAL 0 OR NOT _magic STREQUAL "03022307")
		message(FATAL_ERROR "${f} is not little-endian SPIR-V")
	endif()
	math(EXPR _total "${_total} + ${_bytes}")
	# 24 bytes (48 hex digits) a line, "0x.." comma-separated, as embed_spv.py.
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
	string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],)(0x[0-9a-f][0-9a-f],))" "\t\\1\n" _hex "${_hex}")
	# The last partial line (fewer than 24 bytes) has no tab yet.
	string(REGEX REPLACE "\n(0x[^\n]*)$" "\n\t\\1\n" _hex "${_hex}")
	string(REGEX REPLACE "^(0x[^\n]*)$" "\t\\1\n" _hex "${_hex}")
	string(APPEND _text "static const uint8_t k_${_id}[${_bytes}] = {\n${_hex}};\n\n")
	string(APPEND _entries "\t{ \"${_stem}\", k_${_id}, sizeof(k_${_id}) },\n")
endforeach()
string(APPEND _text "struct Entry {\n\tconst char *name;\n\tconst uint8_t *bytes;\n\tsize_t size;\n};\n\n")
string(APPEND _text "static const Entry kEntries[] = {\n${_entries}};\n")
string(APPEND _text "static const size_t kCount = sizeof(kEntries) / sizeof(kEntries[0]);\n\n")
string(APPEND _text "inline const Entry *find(const char *name) {\n\tfor (size_t i = 0; i < kCount; ++i) {\n\t\tconst char *a = kEntries[i].name;\n\t\tconst char *b = name;\n\t\twhile (*a && *a == *b) { ++a; ++b; }\n\t\tif (*a == 0 && *b == 0) return &kEntries[i];\n\t}\n\treturn nullptr;\n}\n\n} // namespace ${NAMESPACE}\n")
file(WRITE "${OUT}" "${_text}")
message(STATUS "embedded ${_n} kernels, ${_total} bytes -> ${OUT}")
